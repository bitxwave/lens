# Server
# Every var below is also accepted with a `LENS_` prefix
# (e.g. `LENS_PORT`, `LENS_DATA_DIR`, `LENS_BOOTSTRAP_ADMIN_PASSWORD`).
# When both forms are set, the LENS_-prefixed one wins. Use the prefix
# in containers where bare names like `PORT` collide with sidecars.
#
# PORT is the TCP listen port; bind address is always 0.0.0.0.
# Override at runtime with `PORT=9090 cargo run` or `-e PORT=9090` for Docker.
PORT=8080
DATA_DIR=./dev-data
STATIC_DIR=../web/build
RUST_LOG=info,sqlx=warn,tower_http=info

# Auth
# Set on first boot only. Leave empty to have one generated and written
# to ${DATA_DIR}/INITIAL_PASSWORD.txt.
BOOTSTRAP_ADMIN_PASSWORD=

# Security
# Set true behind HTTPS terminator. Cookies become Secure-only.
SECURE_COOKIES=false

# Favicon
# Provider URL template; `{host}` is substituted at fetch time.
# Default Google s2 is unreachable on intranets — override e.g. with
# DuckDuckGo: https://icons.duckduckgo.com/ip3/{host}.ico
#FAVICON_PROVIDER_URL=https://www.google.com/s2/favicons?domain={host}&sz=64
